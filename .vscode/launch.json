    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch frontend dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "export PATH=$HOME/.nvm/versions/node/v24.15.0/bin:$PATH && pnpm run dev",
            "cwd": "${workspaceRoot}/frontend"
        },
        {
            "name": "Launch API",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceRoot}",
            "env": {},
            "args": []
        }
    ]
}
